---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { localePath } from "../i18n";
import type { Locale, PortfolioContent } from "../types/content";
import "@fontsource-variable/onest";
import "../styles/global.css";
interface Props { locale: Locale; content: PortfolioContent; }
const { locale, content } = Astro.props;
const canonical = new URL(localePath(locale), Astro.site ?? Astro.url);
---
<!doctype html>
<html lang={locale} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <meta name="author" content="Sergio Llenderrozos" />
    <meta name="theme-color" content="#f8f9fb" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL("/", canonical)} />
    <link rel="alternate" hreflang="es" href={new URL("/es/", canonical)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", canonical)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_GB"} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const dark = localStorage.getItem("theme") === "dark";
        document.documentElement.classList.toggle("dark", dark);
        document.querySelector('meta[name="theme-color"]').setAttribute("content", dark ? "#101721" : "#f8f9fb");
      } catch { /* Light is the default even when storage is blocked. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{content.nav.skip}</a>
    <span id="external-link-note" hidden>{content.controls.external}</span>
    <Header locale={locale} content={content} />
    <main class="container" id="main" tabindex="-1"><slot /></main>
    <Footer content={content.footer} />
  </body>
</html>
