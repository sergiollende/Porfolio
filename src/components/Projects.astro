---
import Arrow from "./Arrow.astro";
import { getProjectMetadata, getEarlierProjectMetadata } from "../data/profile";
import type { PortfolioContent } from "../types/content";
interface Props { content: PortfolioContent["projects"]; }
const { content } = Astro.props;
---
<section id="projects" class="page-section" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title">{content.title}</h2>
    <p>{content.introduction}</p>
  </div>
  <div class="project-list">
    {content.items.map((project) => {
      const metadata = getProjectMetadata(project.id);
      return (
        <article class:list={["project", { "project-with-image": !!metadata.image }]}>
          <div class="project-intro">
            <h3>{project.title}</h3>
            <p class="project-category">{project.category}</p>
            <p class:list={["project-status", { "status-development": metadata.status === "in-development" }]}><span aria-hidden="true"></span>{project.status}</p>
            <p class="project-description">{project.description}</p>
          </div>
          {metadata.image && <figure class="project-preview">
            <img class="project-image" src={metadata.image.src} alt={project.imageAlt} width={metadata.image.width} height={metadata.image.height} loading="lazy" decoding="async" />
          </figure>}
          <div class="project-content">
            <dl class="project-case">
              <div><dt>{content.problem}</dt><dd>{project.problem}</dd></div>
              <div><dt>{content.contribution}</dt><dd>{project.contribution}</dd></div>
            </dl>
            {project.details.length > 0 && <ul class="project-details">{project.details.map((detail) => <li>{detail}</li>)}</ul>}
            <div class="project-bottom">
              <ul class="technology-list" role="list">{metadata.technologies.map((technology) => <li>{technology}</li>)}</ul>
              <a class="text-link project-visit" href={metadata.url} target="_blank" rel="noopener noreferrer" aria-label={`${content.visit}: ${project.title}`} aria-describedby="external-link-note">{content.visit}<Arrow diagonal /></a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <section class="earlier-projects" aria-labelledby="earlier-projects-title">
    <h3 id="earlier-projects-title">{content.earlier.title}</h3>
    <div class="earlier-project-list">
      {content.earlier.items.map((project) => {
        const metadata = getEarlierProjectMetadata(project.id);
        return (
          <article class="earlier-project">
            <div>
              <h4>{project.title}</h4>
              <p>{project.description}</p>
              <ul class="technology-list" role="list">{metadata.technologies.map((technology) => <li>{technology}</li>)}</ul>
            </div>
            <div class="earlier-project-links">
              <a class="text-link" href={metadata.url} target="_blank" rel="noopener noreferrer" aria-label={`${content.earlier.visit}: ${project.title}`} aria-describedby="external-link-note">{content.earlier.visit}<Arrow diagonal /></a>
              <a class="text-link" href={metadata.github} target="_blank" rel="noopener noreferrer" aria-label={`${content.earlier.code}: ${project.title}`} aria-describedby="external-link-note">{content.earlier.code}<Arrow diagonal /></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</section>
