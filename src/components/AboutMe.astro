---
import type { PortfolioContent } from "../types/content";
interface Props { content: PortfolioContent["about"]; }
const { content } = Astro.props;
---
<section id="about" class="page-section about-section" aria-labelledby="about-title">
  <div class="about-intro"><h2 id="about-title">{content.title}</h2><p>{content.description}</p></div>
  <div class="profile-grid">
    <div class="skills-column">
      <h3>{content.skillsTitle}</h3>
      <dl class="skills-list">{content.skills.map((group) => <div><dt>{group.title}</dt><dd>{group.items.join(" · ")}</dd></div>)}</dl>
    </div>
    <div class="education-column">
      <h3>{content.educationTitle}</h3>
      <p class="degree">{content.degree}</p>
      <p class="education-detail">{content.university}</p>
      <p class="education-detail">{content.exchange}</p>
      <h3 class="languages-title">{content.languagesTitle}</h3>
      <ul class="language-list" role="list">{content.languages.map((language) => <li>{language}</li>)}</ul>
    </div>
  </div>
</section>
