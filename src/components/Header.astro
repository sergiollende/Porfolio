---
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { localePath } from "../i18n";
import type { Locale, PortfolioContent } from "../types/content";
interface Props { locale: Locale; content: PortfolioContent; }
const { locale, content } = Astro.props;
const links = ["experience", "projects", "about", "contact"] as const;
---
<header class="site-header">
  <div class="header-inner container">
    <a class="wordmark" href={localePath(locale)} aria-label={content.nav.home}>sl<span>.</span></a>
    <nav class="primary-nav" aria-label={content.nav.label}>
      {links.map((section) => <a href={`#${section}`}>{content.nav[section]}</a>)}
    </nav>
    <div class="header-controls">
      <LanguagePicker locale={locale} label={content.controls.language} />
      <ThemeToggle label={content.controls.theme} darkLabel={content.controls.dark} lightLabel={content.controls.light} />
    </div>
  </div>
</header>
