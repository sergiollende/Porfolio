---
import ExperienceItem from "./ExperienceItem.astro";
import type { PortfolioContent } from "../types/content";
interface Props { content: PortfolioContent["experience"]; }
const { content } = Astro.props;
---
<section id="experience" class="page-section" aria-labelledby="experience-title">
  <div class="section-heading">
    <h2 id="experience-title">{content.title}</h2>
    <p>{content.introduction}</p>
  </div>
  <div>{content.items.map((experience) => <ExperienceItem experience={experience} />)}</div>
</section>
