---
import type { ExperienceContent } from "../types/content";
interface Props { experience: ExperienceContent; }
const { experience } = Astro.props;
---
<article class="experience-item">
  <div class="experience-company">
    <h3>{experience.company}</h3>
    <p class="period">{experience.period}</p>
    <p class="location">{experience.location}</p>
  </div>
  <div class="experience-body">
    <ul class="role-list" role="list">
      {experience.roles.map((role) => <li><h4>{role.title}</h4>{experience.roles.length > 1 && <p class="period">{role.period}</p>}</li>)}
    </ul>
    {experience.result && <p class="experience-result"><strong>{experience.result.value}</strong>{" "}{experience.result.description}</p>}
    <ul class="achievement-list">
      {experience.highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    <ul class="technology-list" role="list">
      {experience.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
</article>
